{
  "info": {
    "_postman_id": "f04adc67-7e5b-4b6a-ac96-373a8af87662",
    "name": "nelua-api · staging",
    "description": "Pruebas de la API desplegada en staging (https://api-staging.nelua.site).\n\nAntes de empezar: en la colección → Variables, pega en `apiKey` la llave que llegó por correo. No la guardes en el repositorio.\n\nCada petición trae pruebas: Run collection las ejecuta todas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-staging.nelua.site"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "owner",
      "value": "londono652"
    },
    {
      "key": "repo",
      "value": "nelua-api"
    }
  ],
  "item": [
    {
      "name": "1. Operación (sin credenciales)",
      "item": [
        {
          "name": "Salud del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Liveness. Público: dice si el servicio vive y qué versión corre.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae la versión desplegada\", () => pm.expect(pm.response.json()).to.have.property(\"version\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listo para recibir tráfico",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "Readiness: ya leyó el almacén y tiene llaves para autenticar.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Despliegues (GitHub)",
      "item": [
        {
          "name": "Repositorios monitoreados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos"
              ]
            },
            "description": "Repos que sigue la API y qué tan recientes son sus datos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Cada repo trae su meta\", () => body.data.forEach(r => pm.expect(r).to.include.keys(\"repo\", \"meta\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Últimos despliegues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos/{{owner}}/{{repo}}/deploys?environment=staging&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos",
                "{{owner}}",
                "{{repo}}",
                "deploys"
              ],
              "query": [
                {
                  "key": "environment",
                  "value": "staging",
                  "description": "Opcional: staging o prod"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Opcional: 1 a 100"
                }
              ]
            },
            "description": "Últimos despliegues del repo: ambiente, estado, commit, duración y enlace a la ejecución."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Trae meta con la frescura del dato\", () => pm.expect(body.meta).to.include.keys(\"collected_at\", \"stale\", \"sync\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Métricas de despliegue (7 días)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos/{{owner}}/{{repo}}/deploys/stats?days=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos",
                "{{owner}}",
                "{{repo}}",
                "deploys",
                "stats"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "7",
                  "description": "7 o 30"
                }
              ]
            },
            "description": "Tasa de éxito, tasa de fallos (DORA), despliegues por día y duración promedio, por ambiente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Trae meta con la frescura del dato\", () => pm.expect(body.meta).to.include.keys(\"collected_at\", \"stale\", \"sync\"));",
                  "pm.test(\"Todas las filas son de 7 días\", () => body.data.forEach(s => pm.expect(s.window_days).to.eql(7)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Métricas de despliegue (30 días, total)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos/{{owner}}/{{repo}}/deploys/stats?days=30&environment=all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos",
                "{{owner}}",
                "{{repo}}",
                "deploys",
                "stats"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30",
                  "description": "7 o 30"
                },
                {
                  "key": "environment",
                  "value": "all",
                  "description": "Ambiente, o all para el total"
                }
              ]
            },
            "description": "Las mismas métricas en 30 días, sumando todos los ambientes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Trae meta con la frescura del dato\", () => pm.expect(body.meta).to.include.keys(\"collected_at\", \"stale\", \"sync\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Servicios (Kubernetes)",
      "item": [
        {
          "name": "Estado de los deployments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/deployments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "deployments"
              ]
            },
            "description": "Deployments por namespace: réplicas, versión, pods, autoescalado e historial de revisiones (ahí se ven los rollbacks)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Trae meta con la frescura del dato\", () => pm.expect(body.meta).to.include.keys(\"collected_at\", \"stale\", \"sync\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Solo los que tienen problemas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/deployments?status=degraded",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "deployments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "degraded",
                  "description": "healthy, progressing, degraded, unavailable o scaled_down"
                }
              ]
            },
            "description": "Filtra por estado. Con todo sano devuelve una lista vacía."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Costo (AWS Budgets)",
      "item": [
        {
          "name": "Presupuesto del mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/budget",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "budget"
              ]
            },
            "description": "Límite, gasto del mes, pronóstico al cierre y estado (ok, warning, exceeded)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Trae data\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Trae meta con la frescura del dato\", () => pm.expect(body.meta).to.include.keys(\"collected_at\", \"stale\", \"sync\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Errores esperados",
      "item": [
        {
          "name": "Sin API key → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos"
              ]
            },
            "description": "Sin credenciales la API responde 401 con el formato RFC 9457.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Formato problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repo no monitoreado → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos/otro/repo/deploys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos",
                "otro",
                "repo",
                "deploys"
              ]
            },
            "description": "Un repo fuera de la lista responde 404 sin llegar a GitHub, para que nadie gaste el límite del token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Explica el motivo\", () => pm.expect(pm.response.json().detail).to.include(\"no está monitoreado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ventana inválida → 422",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/repos/{{owner}}/{{repo}}/deploys/stats?days=15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "repos",
                "{{owner}}",
                "{{repo}}",
                "deploys",
                "stats"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "15",
                  "description": "Solo se aceptan 7 o 30"
                }
              ]
            },
            "description": "Parámetros inválidos responden 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}