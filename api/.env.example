# Copia este archivo como .env (que NO se versiona) y cambia los valores.

# Llave que hay que enviar en el encabezado X-API-Key.
API_KEYS=cambia-esta-llave-local

# Repositorios que se monitorean, separados por comas (owner/repo).
GITHUB_REPOS=londono652/nelua-api

# Por defecto los despliegues son de ejemplo. Para leer los reales de GitHub:
#   GITHUB_SOURCE=github
#   GITHUB_TOKEN=<token fine-grained de solo lectura, permiso "Deployments: Read">
GITHUB_SOURCE=sample
GITHUB_TOKEN=
