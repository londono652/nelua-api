        <mxCell id="ciApp" value="&lt;b&gt;Pipeline app&lt;/b&gt;&lt;br&gt;&lt;i&gt;cambios en /api y /cicd&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CI&lt;/b&gt;&lt;br&gt;1 · Build y test&lt;br&gt;2 · Calidad y seguridad&lt;br&gt;3 · Build de imagen&lt;br&gt;4 · Push a ECR&lt;br&gt;&lt;br&gt;&lt;b&gt;CD&lt;/b&gt;&lt;br&gt;5 · Deploy a staging&lt;br&gt;6 · Deploy a prod&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(aprobación)&lt;br&gt;cada uno con&lt;br&gt;&lt;b&gt;rollback automático&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;rollback manual:&lt;br&gt;workflow aparte&lt;/i&gt;" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#2088FF;strokeWidth=2;fontSize=10;fontColor=#24292F;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1415" y="225" width="130" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ciInfra" value="&lt;b&gt;Pipeline IaC&lt;/b&gt;&lt;br&gt;&lt;i&gt;cambios en /iac&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Revisión&lt;/b&gt;&lt;br&gt;1 · Validación&lt;br&gt;2 · Seguridad (checkov)&lt;br&gt;3 · Plan de staging&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;y de producción&lt;br&gt;&lt;br&gt;&lt;b&gt;Aplicación&lt;/b&gt;&lt;br&gt;4 · Base compartida&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(aprobación)&lt;br&gt;5 · Staging&lt;br&gt;6 · Producción&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;cada uno con&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;su interruptor" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;fontSize=10;fontColor=#24292F;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
